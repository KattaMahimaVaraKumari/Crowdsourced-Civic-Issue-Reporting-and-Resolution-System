NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/civictrack
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
COOKIE_NAME=civictrack_token
# Used only by scripts/seedUsers.js. Never use these demo credentials in production.
SEED_DEMO_USERS=false
SEED_ADMIN_NAME=CivicTrack Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_OFFICER_NAME=Demo Officer
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=ChangeThisOfficerPassword123!
